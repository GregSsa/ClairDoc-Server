# Copiez ce fichier vers .env et remplacez la valeur par une clé longue et aléatoire.
CLAIRDOC_API_KEY=changez-cette-cle
CLAIRDOC_DATA_DIR=./data
CLAIRDOC_HOST=127.0.0.1
CLAIRDOC_PORT=8787
CLAIRDOC_OCR_COMMAND=ocrmypdf
CLAIRDOC_OCR_LANGUAGES=fra+eng
CLAIRDOC_OCR_WORKERS=1
CLAIRDOC_MAX_UPLOAD_MB=200
CLAIRDOC_CORS_ORIGINS=tauri://localhost,http://tauri.localhost

# Réservé à la future intégration LLM. Cette variable n'est pas encore utilisée.
# OPENAI_API_KEY=

