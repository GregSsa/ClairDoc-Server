CLAIRDOC_API_KEY=changez-cette-cle-partagee
CLAIRDOC_DATA_DIR=./data
CLAIRDOC_HOST=127.0.0.1
CLAIRDOC_PORT=8787
CLAIRDOC_OCR_LANGUAGES=fra+eng
CLAIRDOC_TESSERACT_COMMAND=tesseract

# Clé envoyée uniquement à OpenAI par le serveur ClairDoc.
OPENAI_API_KEY=
CLAIRDOC_EMBEDDING_MODEL=text-embedding-3-small
CLAIRDOC_EMBEDDING_DIMENSIONS=512
CLAIRDOC_LLM_MODEL=gpt-6-luna
CLAIRDOC_RAG_TOP_K=6
CLAIRDOC_RAG_CHUNK_CHARS=2400
CLAIRDOC_RAG_CHUNK_OVERLAP=300
CLAIRDOC_EMBEDDING_PRICE_PER_MILLION_USD=0.02
CLAIRDOC_MAX_INDEX_TOKENS=10000000
CLAIRDOC_OPENAI_MAX_RETRIES=5
CLAIRDOC_OPENAI_TIMEOUT_SECONDS=60
CLAIRDOC_API_REQUESTS_PER_MINUTE=600

# TLS facultatif, recommandé si le serveur est utilisé hors de la machine locale.
# CLAIRDOC_TLS_CERTFILE=/chemin/vers/fullchain.pem
# CLAIRDOC_TLS_KEYFILE=/chemin/vers/privkey.pem
